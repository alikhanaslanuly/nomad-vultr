{
  "name": "airlock-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . ../tests/e2e",
    "format:check": "prettier --check . ../tests/e2e",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:integration": "node --import tsx ../tests/e2e/real-api.ts",
    "test:e2e:api": "node scripts/run-e2e.mjs --api"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}

FROM node:20-bookworm-slim

# Install Python 3, bash, coreutils, libfaketime, curl, network diagnostic tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-minimal \
    bash \
    coreutils \
    libfaketime \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user 'user' with uid/gid 1000
RUN groupadd -g 1000 user && \
    useradd -u 1000 -g user -m -d /home/user -s /bin/bash user

WORKDIR /home/user
USER 1000:1000

ENV HOME=/home/user \
    USER=user \
    PATH=/usr/local/bin:/usr/bin:/bin

CMD ["bash"]


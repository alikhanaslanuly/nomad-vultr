FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 bash coreutils libfaketime curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupmod --new-name user node && usermod --login user --home /home/user node && mkdir -p /home/user && chown 1000:1000 /home/user
WORKDIR /home/user
USER 1000:1000
ENV HOME=/home/user USER=user PATH=/usr/local/bin:/usr/bin:/bin
CMD ["bash"]

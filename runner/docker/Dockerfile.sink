FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    dnsmasq \
    iptables \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY sink_server.py /app/sink_server.py

# DNS sink: resolve all queries to 10.77.0.2
RUN echo "address=/#/10.77.0.2" > /etc/dnsmasq.conf && \
    echo "listen-address=0.0.0.0" >> /etc/dnsmasq.conf && \
    echo "bind-interfaces" >> /etc/dnsmasq.conf

EXPOSE 53/udp 80/tcp 443/tcp

CMD service dnsmasq start && python3 /app/sink_server.py

